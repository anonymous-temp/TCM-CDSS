  "entries": [
    {
      "id": "TCM-FORMULA-6599020BF0D5",
      "name": "三甲复脉汤",
      "source": "《温病条辨》",
      "ingredients": [
        "炙甘草",
        "干地黄",
        "生白芍",
        "麦冬",
        "阿胶",
        "麻仁",
        "生牡蛎",
        "生鳖甲",
        "生龟板"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "温病后期，热烁肝肾之阴，虚风内动之手指蠕动，甚则心中痛，舌干齿黑，唇裂，脉沉细数。"
      ]
    },
    {
      "id": "TCM-FORMULA-0B56B0A7C443",
      "name": "两地汤",
      "source": "《傅青主女科》",
      "ingredients": [
        "大生地",
        "元参",
        "白芍药",
        "麦冬肉",
        "地骨皮",
        "阿胶"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "先期经来只1-2点者。"
      ]
    },
    {
      "id": "TCM-FORMULA-C8B06C7C1C5F",
      "name": "举元煎",
      "source": "《景岳全书》",
      "ingredients": [
        "人参",
        "黄芪",
        "炙甘草",
        "升麻",
        "白术"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "气虚下陷，血崩血脱，亡阳垂危。"
      ]
    },
    {
      "id": "TCM-FORMULA-438647DD3E67",
      "name": "乌药汤",
      "source": "《兰室秘藏》",
      "ingredients": [
        "当归",
        "甘草",
        "木香",
        "乌药",
        "香附子"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "瘀血挟逆气内阻，经前及经行腹痛，血崩、溲血。"
      ]
    },
    {
      "id": "TCM-FORMULA-102C1066AB08",
      "name": "二冬汤",
      "source": "《医学心悟》",
      "ingredients": [
        "天冬",
        "麦冬",
        "花粉",
        "黄芩",
        "知母",
        "甘草",
        "人参",
        "荷叶"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "上消。"
      ]
    },
    {
      "id": "TCM-FORMULA-3A5646375595",
      "name": "人参五味子汤",
      "source": "《幼幼集成》",
      "ingredients": [
        "官拣参",
        "漂白术",
        "白云苓",
        "北五味",
        "杭麦冬",
        "炙甘草"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "久嗽脾虚，中气怯弱，面白唇白。"
      ]
    },
    {
      "id": "TCM-FORMULA-A69B1E7EAB86",
      "name": "会厌逐瘀汤",
      "source": "《医林改错》",
      "ingredients": [
        "桃仁",
        "红花",
        "甘草",
        "桔梗",
        "生地",
        "当归",
        "玄参",
        "柴胡",
        "枳壳",
        "赤芍"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "痘5-6天后，饮水即呛；瘀血凝滞之呃逆。"
      ]
    },
    {
      "id": "TCM-FORMULA-0E74817FBDD3",
      "name": "保阴煎",
      "source": "《景岳全书》",
      "ingredients": [
        "生地",
        "熟地",
        "芍药",
        "山药",
        "川续断",
        "黄芩",
        "黄柏",
        "生甘草"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "男妇带浊遗淋，色赤带血，脉滑多热，便血不止，及血崩血淋，或经期太早，凡一切阴虚内热动血等证。胎气热而不安，及产妇淋沥不止。"
      ]
    },
    {
      "id": "TCM-FORMULA-29D34F6798E1",
      "name": "养精种玉汤",
      "source": "《傅青主女科》",
      "ingredients": [
        "大熟地",
        "当归",
        "白芍",
        "山萸肉"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "妇人身瘦不孕，一交男子，即卧病终朝。"
      ]
    },
    {
      "id": "TCM-FORMULA-48159221DFAF",
      "name": "凉血地黄汤",
      "source": "《外科大成》",
      "ingredients": [
        "归尾",
        "生地",
        "赤芍",
        "黄连",
        "枳壳",
        "黄芩",
        "槐角",
        "地榆",
        "荆芥",
        "升麻",
        "天花粉",
        "甘草"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "痔肿痛，出血。"
      ]
    },
    {
      "id": "TCM-FORMULA-D0A23FE50787",
      "name": "化肝煎",
      "source": "《景岳全书》",
      "ingredients": [
        "青皮",
        "陈皮",
        "芍药",
        "丹皮",
        "栀子",
        "泽泻",
        "土贝母"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "怒气伤肝，因而气逆动火，致为烦热、胁痛、胀满、动血，咳吐痰血。"
      ]
    },
    {
      "id": "TCM-FORMULA-54771499B671",
      "name": "半夏泻心汤",
      "source": "《伤寒论》",
      "ingredients": [
        "半夏",
        "黄芩",
        "干姜",
        "人参",
        "甘草",
        "黄连",
        "大枣"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "寒热平调，消痞散结。主治寒热错杂之痞证。心下痞，但满而不痛，或呕吐，肠鸣下利，舌苔腻而微黄。"
      ]
    },
    {
      "id": "TCM-FORMULA-48F5B7D425E8",
      "name": "半夏白术天麻汤",
      "source": "《医学心悟》",
      "ingredients": [
        "半夏",
        "天麻",
        "茯苓",
        "橘红",
        "白术",
        "甘草"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "痰厥头痛者，胸隔多痰，动则眩晕。"
      ]
    },
    {
      "id": "TCM-FORMULA-36D1EB6876C9",
      "name": "吴茱萸汤",
      "source": "《伤寒论》",
      "ingredients": [
        "吴茱萸",
        "人参",
        "生姜",
        "大枣"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "胃中虚寒，干呕，胸满，吐涎沫；厥阴头痛；少阴吐利，手足逆冷；吞酸。现用于神经性呕吐、偏头痛、神经性头痛、美尼尔氏综合症等属肝胃虚寒者。"
      ]
    },
    {
      "id": "TCM-FORMULA-F40764195BB4",
      "name": "四妙勇安汤",
      "source": "《验方新编》",
      "ingredients": [
        "金银花",
        "元参",
        "当归",
        "甘草"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "脱骨疽。"
      ]
    },
    {
      "id": "TCM-FORMULA-4ECDEE25DCC5",
      "name": "固本止崩汤",
      "source": "《傅青主女科》",
      "ingredients": [
        "大熟地",
        "白术",
        "黄芪",
        "当归",
        "黑姜",
        "人参"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "妇人虚火血崩，两目黑暗，昏晕在地，不省人事。"
      ]
    },
    {
      "id": "TCM-FORMULA-A466A910AA92",
      "name": "固阴煎",
      "source": "《景岳全书》",
      "ingredients": [
        "人参随宜",
        "熟地",
        "山药",
        "山茱萸",
        "远志",
        "炙甘草",
        "五味子十四粒",
        "菟丝子"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "肝肾两亏，遗精滑泄，带下崩漏，胎动不安，产后恶露不止，妇人阴挺。带浊淋遗，及经水因虚不固。肝肾血虚，胎动不安；产后冲任损伤，恶露不止。阴虚滑脱，以致下坠者。"
      ]
    },
    {
      "id": "TCM-FORMULA-5D0C06BC6F88",
      "name": "圣愈汤",
      "source": "《兰室秘藏》",
      "ingredients": [
        "生地黄",
        "熟地黄",
        "川芎",
        "人参",
        "当归身",
        "黄芪"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "诸恶疮，血出多而心烦不安，不得睡眠。一切失血；或血虚烦渴、躁热，睡卧不宁；或疮证脓水出多，五心烦热，作渴等。"
      ]
    },
    {
      "id": "TCM-FORMULA-7747D8890B49",
      "name": "增液承气汤",
      "source": "《温病条辨》",
      "ingredients": [
        "元参",
        "麦冬",
        "细生地",
        "大黄",
        "芒硝"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "阳明温病，津液不足，无水舟停，下之不通，间服增液仍不下者。"
      ]
    },
    {
      "id": "TCM-FORMULA-3CF41EA8B97C",
      "name": "大黄䗪虫丸",
      "source": "《金匮要略·血痹虚劳病脉证并治第六》",
      "ingredients": [
        "大黄",
        "黄芩",
        "甘草",
        "桃仁",
        "杏仁",
        "白芍",
        "干地黄",
        "干漆",
        "虻虫",
        "水蛭",
        "蛴螬",
        "䗪虫"
      ],
      "catalog": "verified_reference_catalog",
      "indications": [
        "五劳虚极羸瘦，腹满不能饮食，肌肤甲错，两目黯黑，内有干血。"
      ]
    },
    {
      "id": "TCM-FORMULA-3DC75B90A43C",
      "name": "完带汤",
      "source": "《傅青主女科》",
      "ingredients": [
        "白术",
        "山药",
        "人参",
        "白芍",
        "车前子",
        "苍术",
        "甘草",
        "陈皮",
        "黑芥穗",
        "柴胡"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "妇人湿盛火衰，肝郁气弱，脾土受伤，湿气下陷，致患白带终年累月下流白物，如涕如唾，不能禁止，甚则臭秽者。"
      ]
    },
    {
      "id": "TCM-FORMULA-9CB8095EAE49",
      "name": "定经汤",
      "source": "《傅青主女科》",
      "ingredients": [
        "菟丝子",
        "白芍",
        "当归",
        "大熟地",
        "山药",
        "白茯苓",
        "芥穗",
        "柴胡"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "妇人经来断续，或前或后无定期。"
      ]
    },
    {
      "id": "TCM-FORMULA-AA59315606E0",
      "name": "宣痹汤",
      "source": "《温病条辨》",
      "ingredients": [
        "防己",
        "杏仁",
        "滑石",
        "连翘",
        "山栀",
        "薏苡",
        "半夏",
        "晚蚕沙",
        "赤小豆皮"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "太阴湿温，气分痹郁而哕者。",
        "湿痹。湿聚热蒸，蕴于经络，寒战热炽，骨骱烦疼，舌色灰滞，面目萎黄。"
      ]
    },
    {
      "id": "TCM-FORMULA-95FE554648C9",
      "name": "宣郁通经汤",
      "source": "《傅青主女科》",
      "ingredients": [
        "白芍",
        "当归",
        "丹皮",
        "山栀子",
        "白芥子",
        "柴胡",
        "香附",
        "川郁金",
        "黄芩",
        "生甘草"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "妇人经前腹疼数日，而后经水行，经来多紫黑块。"
      ]
    },
    {
      "id": "TCM-FORMULA-9C99D440A742",
      "name": "导痰汤",
      "source": "《传信适用方》",
      "ingredients": [
        "半夏",
        "天南星",
        "枳实",
        "橘红",
        "赤茯苓"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "痰凝气滞，胸膈痞塞，胁肋胀满，头痛吐逆，痰嗽喘急，不思饮食，以及头晕，不寐，短气，谵语，中风，痰厥，痰呃。"
      ]
    },
    {
      "id": "TCM-FORMULA-9F1FC6577C70",
      "name": "小承气汤",
      "source": "《伤寒论》",
      "ingredients": [
        "大黄",
        "厚朴",
        "枳实"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "阳明腑实证，热邪与积滞互结，潮热谵语，大便秘结，胸腹痞满，苔黄糙，脉滑数；或热结旁流，下利清水；或痢疾初起，腹痛胀满，里急后重。霍乱，大便不通，哕数口，谵语。杂病上焦痞满不通。里症已见三四，脐腹胀满而不甚坚硬，或胸满潮热不恶寒，狂言而喘，病属小热小实小满者。邪传少阴，口燥咽干而渴，或下利肠垢，目不明。"
      ]
    },
    {
      "id": "TCM-FORMULA-3B3F2D8E4C85",
      "name": "小陷胸汤",
      "source": "《伤寒论》",
      "ingredients": [
        "黄连",
        "半夏",
        "瓜蒌实"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "小结胸病，心下按之则痛，舌苔黄腻，脉浮滑。及痰热互结而成的胸痹，或痰热在膈上而致的咳嗽面赤，胸腹常热，脉洪，苔黄腻。小结胸病，正在心下，按之则痛，脉浮滑。时气结胸，心下坚，按之即痛，其脉沉滑。伤寒发渴而饮水太过，成水结胸而发呃。痰热塞胸。痰热互结而成的胸痹，及热痰在膈上所致的咳嗽面赤，胸腹常热（唯手足有时觉凉），脉洪。"
      ]
    },
    {
      "id": "TCM-FORMULA-6A70810BEDB9",
      "name": "左归饮",
      "source": "《景岳全书》",
      "ingredients": [
        "熟地",
        "山药",
        "枸杞",
        "炙甘草",
        "茯苓",
        "山茱萸"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "真阴不足，腰痠且痛，遗精盗汗，咽燥口渴；阴衰阳胜，身热烦渴，脉虚气弱。"
      ]
    },
    {
      "id": "TCM-FORMULA-5D7768F0CBF8",
      "name": "异功散",
      "source": "《小儿药证直诀》",
      "ingredients": [
        "人参",
        "茯苓",
        "白术",
        "陈皮",
        "甘草"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "脾虚气滞。饮食减少，胸脘痞闷，食入作胀，大便溏薄，神疲气短，身体羸瘦，或面部浮肿者。"
      ]
    },
    {
      "id": "TCM-FORMULA-144F389252B5",
      "name": "归脾汤",
      "source": "《济生》卷四。",
      "ingredients": [
        "白术",
        "茯苓",
        "黄耆",
        "龙眼肉",
        "酸枣仁",
        "人参",
        "木香",
        "甘草"
      ],
      "catalog": "verified_reference_catalog",
      "indications": [
        "思虑伤脾，健忘怔忡，吐血下血。",
        "心脾气血两虚证：心悸怔忡，健忘失眠，盗汗，体倦食少，面色萎黄，舌淡，苔薄白，脉细弱（《方剂学》规划教材主治，用于检索召回）。",
        "思虑伤脾。健忘怔忡，吐血下血。"
      ]
    },
    {
      "id": "TCM-FORMULA-B6D2B19C4C20",
      "name": "当归四逆汤",
      "source": "《伤寒论》",
      "ingredients": [
        "当归",
        "桂枝",
        "芍药",
        "细辛",
        "甘草",
        "通草",
        "大枣"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "血虚受寒，手足厥寒；舌淡苔白，脉沉细或沉细欲绝者；并治寒入经络，以致腰股、腿、足疼痛或麻木。现用于早期雷诺氏病及冻伤。"
      ]
    },
    {
      "id": "TCM-FORMULA-1F2E9B8F88FE",
      "name": "托里消毒散",
      "source": "《外科正宗》",
      "ingredients": [
        "人参",
        "川芎",
        "白芍",
        "黄芪",
        "当归",
        "白术",
        "茯苓",
        "金银花",
        "白芷",
        "甘草",
        "皂角针",
        "桔梗"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "痈疽已成，不得内消者。"
      ]
    },
    {
      "id": "TCM-FORMULA-C85F959EC5B2",
      "name": "散偏汤",
      "source": "《辨证录》",
      "ingredients": [
        "白芍",
        "川芎",
        "郁李仁",
        "柴胡",
        "白芥子",
        "香附",
        "甘草",
        "白芷"
      ],
      "catalog": "official_classic_catalog",
      "indications": [
        "郁气不宣，复因风邪袭于少阳之经，以致半边头痛。"
      ]
    },
    {
