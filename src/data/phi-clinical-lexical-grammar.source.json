{
  "schemaVersion": "phi-clinical-lexical-grammar-v1",
  "purpose": "姓名候选的构词式消歧，仅保护临床词形；不识别患者事实、不产生诊断或风险结论。明确姓名字段和人员标签优先，不因临床词形豁免。",
  "evidence": "2026-09-11 以 tcm-modern-case-eval-corpus 17,270 例的主诉/四诊/病机叙述（50,448 段，几乎不含患者姓名）实测：仅凭疾病/病位/望诊词表时仍有 851 处临床词被当作姓名抹掉（边缘 235、经行/经期 110、时常/经常 69、双下肢/左侧/双手 58、劳累后 10 …）。以下新增各组均来自该实测的误脱敏类别；每组以常见姓×常见名×既有叙述句式做隐私反证，不得新增任何姓名泄漏。",
  "groups": [
    {
      "id": "body_distribution",
      "prefixes": ["全", "周", "浑", "遍", "通"],
      "suffixes": ["身"],
      "basis": "范围修饰语与身体名词构词；避免按姓氏将分布范围当作人名。"
    },
    {
      "id": "body_orientation",
      "prefixes": ["前", "后", "左", "右", "上", "下", "双", "单", "两"],
      "suffixes": ["胸", "背", "腹", "腰", "肢", "肩", "臂", "腿", "腕", "膝", "眼", "耳", "侧", "边", "半", "手", "足", "脚", "目", "颊", "乳", "肘", "肺", "肾", "颈", "项", "髋", "踝", "指", "趾", "掌", "肋", "胁", "额", "颞", "鼻", "唇", "腋", "颌"],
      "basis": "方位词、侧别量词（双/单/两）与身体部位构词；闭集仅用于姓名消歧，不替代解剖映射。「左侧头痛」「双手有疱疹」曾被抹成姓名，侧别与部位随之丢失。"
    },
    {
      "id": "body_orientation_compound",
      "prefixes": ["左", "右", "双", "单", "两"],
      "suffixes": ["下肢", "上肢", "小腿", "大腿", "手臂", "手指", "手掌", "足底", "足心", "足部", "足背", "眼前", "眼球", "眼睑", "鼻孔", "耳后", "腋下", "颊部", "乳房", "肾区", "腹部", "肩部", "肩胛", "胁肋", "胁下", "少腹", "小腹", "下腹", "上腹", "腰部", "背部", "胸部", "后脑", "中指", "食指", "拇指", "半身"],
      "basis": "侧别量词加双字部位词（双下肢/左下腹/双眼前）。姓名候选最长为姓+2 字，三字部位词正落在该长度上。"
    },
    {
      "id": "body_quadrant",
      "prefixes": ["左", "右"],
      "suffixes": ["上", "下", "前", "后"],
      "basis": "象限方位构词（左下腹痛/右上腹痛/左前胸），侧别随「左下」一并被抹去会使腹痛失去定位。"
    },
    {
      "id": "tongue_region",
      "prefixes": ["边"],
      "suffixes": ["缘", "尖", "齿"],
      "basis": "舌诊分区（舌边缘/边尖/边齿痕）在逗号后省略「舌」字时以「边」起首；与舌苔组同属四诊构词。"
    },
    {
      "id": "menstrual_phase",
      "prefixes": ["经"],
      "suffixes": ["行", "期", "前", "后", "来", "血", "闭", "痛", "间", "量", "色", "质", "水", "净", "尽", "至"],
      "basis": "月经时相与经血性状构词（经行腹痛/经期头痛/经前乳胀/经血有块）；时相是妇科辨证的关键事实。"
    },
    {
      "id": "frequency_predicate",
      "prefixes": ["常", "时", "偶", "素", "久"],
      "suffixes": ["有", "感", "觉", "伴", "作", "夹", "欲", "见"],
      "basis": "频度或时相副词加存在/感知/伴随/发作动词，属于叙述而非名词性人员身份。刻意不收「常发/时发」：与常/时姓加常见名字「发」同形，隐私优先。"
    },
    {
      "id": "frequency_adverb",
      "terms": ["时常", "经常", "常常", "平时", "平日", "平常", "时时", "时而", "时或", "曾经", "通常", "终日", "常年", "经年", "素来", "向来", "后来", "平卧", "平躺"],
      "basis": "频度/时相副词与体位词的封闭集合；以姓氏字起首（时/经/常/平/曾/通/终/素/向/后），不是名词性人员身份。刻意不收「平素」：与平姓加常见名字「素」同形（平素芬、平素英），隐私优先，「平素有反酸」维持脱敏。"
    },
    {
      "id": "exertion_trigger",
      "prefixes": ["劳"],
      "suffixes": ["累", "作", "神", "倦", "后", "动", "碌", "损", "伤"],
      "basis": "劳力/劳神诱因与劳损构词。「劳累后出现胸闷」若被抹去，劳力性诱因这一胸痛分诊关键事实随之丢失。刻意不收「劳力」：与劳姓加常见名字「力」同形。"
    },
    {
      "id": "surface_anatomy",
      "terms": ["关节", "巩膜", "颜面", "皮下", "皮损", "皮疹", "周围", "周边", "黄斑", "红斑", "红肿", "麻木", "包块"],
      "basis": "体表/查体部位与皮损形态的封闭集合（巩膜有黄染/皮下有硬结/周围有脱屑），不在疾病与病位词表内而以姓氏字起首。"
    },
    {
      "id": "stagnation_pathomechanism",
      "prefixes": ["郁"],
      "suffixes": ["而", "结", "阻", "积", "热", "遏", "蒸", "滞", "闭", "火", "久"],
      "basis": "郁滞类病机构词（郁而化热/郁结/郁阻），属病机叙述。"
    },
    {
      "id": "fluid_pathomechanism",
      "prefixes": ["水"],
      "suffixes": ["亏", "泛", "停", "湿", "液", "道", "谷", "火", "饮", "气", "逆", "犯", "溢", "聚"],
      "basis": "水液代谢类病机构词（水湿泛溢/水亏/水停），属病机叙述。"
    },
    {
      "id": "defensive_qi_pathomechanism",
      "prefixes": ["卫"],
      "suffixes": ["气", "行", "分", "外", "表"],
      "basis": "卫气/卫分类病机构词（卫气郁/卫外不固）。刻意不收「卫阳」：与「卫」姓加常见名字「阳」同形，隐私优先。"
    },
    {
      "id": "latent_pathogen_pathomechanism",
      "prefixes": ["伏"],
      "suffixes": ["藏", "邪", "热", "气"],
      "basis": "伏邪类病机构词（伏藏/伏邪），属病机叙述。"
    },
    {
      "id": "residual_pathogen_pathomechanism",
      "prefixes": ["余"],
      "suffixes": ["毒", "邪", "热"],
      "basis": "余邪未尽类病机构词（余毒蕴结/余热未清），属病机叙述。"
    },
    {
      "id": "mutual_pathomechanism",
      "prefixes": ["相"],
      "suffixes": ["搏", "蒸", "兼", "结"],
      "basis": "病邪相合类病机构词（湿热相搏/相蒸），属病机叙述。"
    },
    {
      "id": "high_fever",
      "prefixes": ["高"],
      "suffixes": ["热", "烧"],
      "basis": "发热程度构词（高热出现于午后），以姓氏字起首的症状词。"
    },
    {
      "id": "dry_symptom",
      "prefixes": ["干"],
      "suffixes": ["咳", "哕"],
      "basis": "干性症状构词（干咳/干哕），与疾病词表已收的「干呕」同类。"
    },
    {
      "id": "sudden_onset",
      "prefixes": ["暴"],
      "suffixes": ["聋", "盲", "泻"],
      "basis": "急骤起病构词（暴聋/暴泻），属症状叙述。刻意不收「暴发」：与暴姓加常见名字「发」同形。"
    },
    {
      "id": "susceptibility_predicate",
      "prefixes": ["易"],
      "suffixes": ["醒", "怒", "汗", "惊"],
      "basis": "易发倾向构词（易醒难寐/易怒/易汗），属症状叙述。"
    },
    {
      "id": "narrative_connective",
      "terms": ["严重", "明显", "容易", "相当", "包括", "习惯", "应属", "都属", "尤其", "关键", "充斥", "连及", "苏醒", "夏季", "冬季", "秋季", "春季"],
      "basis": "程度副词、叙述连接词与季节词的封闭集合；以姓氏字起首而无人员身份含义。刻意不收「后天」：与后姓加常见名字「天」同形。"
    },
    {
      "id": "tongue_coating",
      "prefixes": ["白", "黄", "黑", "灰", "薄", "厚"],
      "suffixes": ["苔"],
      "basis": "色泽/厚薄加苔的四诊构词，不依据该词对患者作肯定断言。"
    }
  ],
  "lexemeFollowers": {
    "characters": ["失", "已", "前", "后", "伴", "时", "偏", "部", "上", "下", "偶", "由", "也", "属", "稍", "没", "带", "略", "性", "难", "还", "或", "在", "对", "区", "又", "内", "起", "会", "间", "无", "只", "的", "附", "嗜", "欲", "及", "并", "而", "均", "仍", "渐", "再", "即", "则", "且", "等", "较", "未", "不", "处", "旁"],
    "basis": "姓名候选是姓+{1,2} 字的贪婪匹配，临床词后紧跟的一个功能/方位语素（全身伴有、干咳已有、劳累后出现、左腹部）会被并入三字候选。仅当三字候选的前两字是本表词条、且第三字属于本封闭集合时视为临床词形。集合只收体、时、方位、连接、否定等功能语素，刻意不收可作名字用字的「中/少/小/和/常/期」——前两字即便与名字同形（如疾病词表的「强中」），「强中华」这类三字姓名仍照常脱敏。"
  }
}
