    {"bookKey": "supplement", "book": "中医骨伤科学", "department": "骨伤", "disease": "骨折", "line": 187196, "definition": "骨的完整性或连续性遭到破坏者，称为骨折。", "diseaseAliases": ["骨折病"], "westernEquivalents": ["骨折"], "tcmEquivalents": [], "differentials": [{"name": "伤筋", "text": "《中医骨伤科学》骨折概论：畸形、骨擦音和异常活动是骨折的特征，这三种特征只要其中一种出现，即可初步诊断为骨折；伤筋无此特征，影像学检查可资鉴别。"}], "note": "教材按损伤三期（初、中、后期）辨证用药，不分证型；这里按教材原文把三期各列一行（后期按补益肝肾、补气养血分两行）。2026-10-19 验收主集两例肋骨骨折被命名为胸部屏挫伤，原因是教材表里没有骨折这一病。"},
    {"bookKey": "supplement", "book": "针灸治疗学", "department": "耳鼻喉口齿", "disease": "耳鸣耳聋", "line": 12033, "definition": "耳鸣是以耳内鸣响，如蝉如潮，妨碍听觉为主症；耳聋是以听力不同程度减退或失听为主症，轻者称“重听”。", "diseaseAliases": ["耳鸣", "耳聋", "暴聋", "久聋"], "westernEquivalents": ["突发性耳聋", "突发性聋", "感音神经性聋", "神经性耳鸣", "耳鸣"], "tcmEquivalents": [], "differentials": [{"name": "耳胀", "text": "《中医食疗学》耳鸣、耳聋节辨证要点：实证者病情突发，以单侧为重，耳鸣呈低音调，听力下降；虚证者起病缓慢，逐渐加重，以双侧为多。耳胀以耳内胀闷堵塞感为主。"}]},
    {"bookKey": "supplement", "book": "针灸治疗学", "department": "急症", "disease": "虚脱", "line": 12298, "definition": "虚脱是以突然面色苍白，大汗淋漓，四肢逆冷，表情淡漠，或烦躁不安，甚则昏迷，二便失禁，血压下降，脉微欲绝为主要特征的病证。西医学中，虚脱多见于各种原因引起的休克。", "diagnosisPoints": ["主症 面色苍白，汗出淋漓，神情迟钝，四肢厥逆，少尿或二便失禁，甚则昏迷，血压下降，脉微欲绝。", "西医学中，虚脱多见于各种原因引起的休克。"], "diseaseAliases": ["脱证", "厥脱"], "westernEquivalents": ["休克", "过敏性休克", "感染性休克", "脓毒性休克", "失血性休克", "创伤性休克", "心源性休克", "低血容量性休克"], "tcmEquivalents": [], "differentials": [{"name": "厥证", "text": "《针灸治疗学》晕厥节：晕厥是以突发而短暂的意识丧失，四肢厥冷为主症的病证。虚脱以面色苍白、大汗淋漓、四肢逆冷、血压下降、脉微欲绝为主要特征。"}]}
