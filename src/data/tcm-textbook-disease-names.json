 "tcmNameBasis": {
  "血栓闭塞性脉管炎": {
   "book": "中医外科学",
   "line": 213661,
   "quote": "血栓闭塞性脉管炎属中医学“脱疽”的范畴，是一种中小动静脉的周期性、节段性、慢性炎症病变，是以血管腔发生闭塞，引起局部组织缺血，最后坏死致肢体末端脱落为病变过程的疾病。"
  },
  "股骨头缺血性坏死": {
   "book": "中医骨伤科学",
   "line": 195359,
   "quote": "股骨头缺血性坏死属中医学“骨痹”“骨蚀”范畴。"
  },
  "缺铁性贫血": {
   "book": "中西医结合内科学",
   "line": 134136,
   "quote": "缺铁性贫血(iron deficient anemia，IDA)是指缺铁所引起的小细胞低色素性贫血及相关的缺铁异常，是血红蛋白合成异常性贫血的一种。其特点是骨髓、肝、脾等器官组织中缺乏可染色性铁，血清铁浓度、转铁蛋白饱和度和血清铁蛋白降低。"
  },
  "肩关节周围炎": {
   "book": "中医骨伤科学",
   "line": 192289,
   "quote": "肩关节周围炎是指一种以肩痛、肩关节活动障碍为主要特征的筋\n伤，简称“肩周炎”。其病名较多，因睡眠时肩部受凉引起的称“漏肩\n风”或“露肩风”；因肩部活动明显受限，形同冻结而称“冻结肩”；因该病\n多发于50岁左右患者又称“五十肩”；还有称“肩凝"
  },
  "流行性腮腺炎": {
   "line": 171418,
   "quote": "发热、耳下腮部肿胀、疼痛为主要临床特征。中医称为痄腮"
  },
  "流行性乙型脑炎": {
   "line": 171578,
   "quote": "脱为特征。中医称为“小儿暑温”"
  },
  "营养性缺铁性贫血": {
   "line": 167929,
   "quote": "疗效果良好等特点。属于中医“血虚”“虚劳”范畴"
  },
  "病毒性心肌炎": {
   "line": 168477,
   "quote": "专门记载，根据本病的主要临床症状，属于中医学风温、心悸、怔忡"
  },
  "皮肤黏膜淋巴结综合征": {
   "line": 172678,
   "quote": "、草莓舌、颈淋巴结肿大、手足硬肿为特征，属于中医学温病范畴"
  },
  "传染性单核细胞增多症": {
   "line": 172515,
   "quote": "象异形淋巴细胞和单核细胞增多为主要特征。属中医学温病范畴"
  },
  "硬肿症": {
   "line": 164805,
   "quote": "称新生儿寒冷损伤综合征。本病可归属于中医胎寒、五硬等范畴"
  },
  "猩红热": {
   "line": 170932,
   "quote": "“烂喉痴”“烂喉丹痴”"
  },
  "慢性淋巴细胞性甲状腺炎": {
   "line": 205559,
   "quote": "对应中医病名，根据其颈前肿大特点，可以归属中医“瘿病”的范畴"
  },
  "尿石症": {
   "line": 212278,
   "quote": "3：1。我国长江以南为高发地区之一。本病属于中医学“石淋”的范畴"
  },
  "前列腺癌": {
   "line": 212934,
   "quote": "速。本病常见于50岁以上的男性，属中医学“瘙瘕”的范畴"
  },
  "淋巴水肿": {
   "line": 214035,
   "quote": "本病属于中医学“大脚风”"
  },
  "淋病": {
   "line": 209572,
   "quote": "要通过性交传染，极少数也可通过间接传染。中医称之为“花柳毒淋”"
  },
  "化脓性关节炎": {
   "line": 194975,
   "quote": "节和膝关节。化脓性关节炎属中医“无头疽”范畴"
  }
 },
