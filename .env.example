# TCM CDSS text model: Qwen production matrix. DeepSeek variables remain configured as the
# documented rollback provider and are never sent to the Bailian endpoint.
# Two tiers only (owner decision 2026-09-19): qwen3.8-flash for every first pass and auxiliary task,
# qwen3.8-max for repair rounds, all three clinical-facts phases and the M04 transport fallback. Both enforce
# strict JSON Schema. qwen3.7-flash does not (json_object only), so do not route structured stages to it.
AI_TEXT_PROVIDER=bailian-qwen
# Opt-in experiment: mark only public stable prompt prefixes on Bailian Qwen requests.
# Default false preserves implicit caching/string content. Provider minimum is 1024 tokens;
# When true, public norms move to the existing system message; patient data stays in user.
# This role/layout change is experimental. For cache-only A/B, strip markers from SAME layout.
# cache creation is asynchronous after completion, TTL is 5 minutes refreshed by hits.
# Eligibility/hits and model-specific pricing must be measured, never assumed.
CDSS_EXPLICIT_PROMPT_CACHE=false
BAILIAN_QWEN_API_KEY=
BAILIAN_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_QWEN_MODEL=qwen3.8-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
CDSS_TEXT_MODEL_ALLOWED_HOSTS=
CDSS_DEEPSEEK_ALLOWED_HOSTS=
OPENAI_MODEL=deepseek-v4-flash
# Compatibility topology: callers that already use generic OpenAI-compatible variables may set
# OPENAI_BASE_URL to DashScope and OPENAI_MODEL to qwen*. The endpoint/model family gate remains
# enforced; provider-private credentials are never borrowed across the two configuration surfaces.
# 独立闭集术语归一层（不是临床生成阶段的降级模型）：精确匹配 miss 后由模型在服务端预筛候选中
# 单次选择（2026-09-20 起，原为同一提示词连发两遍取一致）；只形成待医生确认的召回建议，不静默替换签名主证候。
CONTROLLED_TERMINOLOGY_NORMALIZATION=true
# 小任务跑在 DeepSeek 上（2026-09-20）：本机同时段 A/B，真实提示词，术语归一 6673→1354ms、
# 证候重排 5549→984ms、M05 作文 9587→4163ms，出字速度 154–215 tok/s vs 8–61，临床字段无差异。
# 主生成不动：严格 JSON Schema 是 2026-09-19 换回 Qwen 的全部理由，DeepSeek 的 json_object 不执行 schema。
# 该家族没配齐（缺 OPENAI_API_KEY / 端点不在白名单）时 fail-closed，五个小任务各自退回确定性结果。
# 回滚：改回 qwen3.8-flash 即可，无需改代码或重建镜像。
CONTROLLED_TERMINOLOGY_MODEL=deepseek-flash
CONTROLLED_TERMINOLOGY_MIN_CONFIDENCE=0.8
# 两条并集/删减型辅助语义层。默认开启；失败均降级到确定性结果，不得改写患者事实或放宽门禁。
FORMULA_RECALL_NORMALIZATION=true
POLARITY_NEGATION_ASSIST=true
# 可选。未配置时写入 artifacts/runtime；生产容器可挂载持久卷并指向该目录。
# CONTROLLED_TERMINOLOGY_CACHE_PATH=/var/lib/tcm-cdss/controlled-terminology-cache.json
# 院内药品库存落盘路径（POST /api/drug-inventory 导入的院内在售目录）。
# 未配置时写入 artifacts/runtime，容器重建即丢；生产必须指向持久卷，否则每次发布后
# 库存归零、全部药味退回 unknown（不阻断开方，但缺货标注与替代建议一并消失）。
# CDSS_DRUG_INVENTORY_PATH=/app/runtime-data/drug-inventory
PRIMARY_TEXT_TEMPERATURE=0.1
PRIMARY_TEXT_MAX_TOKENS=14000
PRIMARY_TEXT_REASONING_EFFORT=low
# Qwen thinking parameter mapping: qwen3.8-flash/max map local low/medium/high to provider low/medium/xhigh;
# qwen3.7 models map low/medium/high/xhigh to bounded thinking_budget values. When thinking is
# disabled the effort value is intentionally ignored instead of creating a false quality knob.
PRIMARY_DIAGNOSE_REASONING_EFFORT=medium
# M03 结构化定向修复会在通过后再经独立临床复核，默认 low 避免重复一整轮诊断推理时延。
PRIMARY_DIAGNOSE_REPAIR_REASONING_EFFORT=low
# 缺省与本行一致为 false。项目会把“仅返回 reasoning_content、没有最终 content”视为错误，
# 因此部署若主动开启思考模式，必须用 model-health?check=1 验证供应商仍返回最终正文。
# M02 没有独立的 *_THINKING_ENABLED 覆盖项，会跟随本开关。
PRIMARY_TEXT_THINKING_ENABLED=false
# 首轮生成（M02 出题、M03 两半、M04 首轮）跑 DeepSeek（2026-09-24，提速第三批）。同一批真实提示词
# 在生产机直连重放：西医半 24→8s、中医半 29→10s、M04 27→11s、M02 15→4s。DeepSeek 只有
# json_object，所以：① M03 两半的系统消息附上严格供应商的同一份 schema（M04 不附，实测附了反而更差）；
# ② 服务端用同一份 schema 逐项校验（model-response-format.checkNonStrictStructuredContent）；
# ③ 不合规、连不上或非 2xx 时由 PRIMARY_STRUCTURED_FALLBACK_MODEL 对同一份提示词重生成（非流式）。
# 兜底模型必须支持严格 schema；取值 none 关闭兜底。端点按模型家族解析，主 provider 仍是百炼。
# 回滚：PRIMARY_DIAGNOSE_MODEL / PRIMARY_PRESCRIBE_MODEL 改回 qwen3.8-flash，删掉 PRIMARY_QUESTION_MODEL。
PRIMARY_QUESTION_MODEL=deepseek-flash
PRIMARY_STRUCTURED_FALLBACK_MODEL=qwen3.8-flash
# Strict-capable (Qwen) M03 calls pin clinically mandatory arrays to minItems:1 in the provider schema
# (model-response-format.ts): under strict decoding Qwen otherwise returns them empty.
PRIMARY_DIAGNOSE_MODEL=deepseek-flash
# M03 语义修复会从患者事实重新生成完整诊断，结果仍须经全新的复核请求独立校验。
PRIMARY_DIAGNOSE_REPAIR_MODEL=qwen3.8-max
PRIMARY_DIAGNOSE_THINKING_ENABLED=false
PRIMARY_PRESCRIBE_MODEL=deepseek-flash
# 首轮连接/首包超过此预算即切换传输兜底；不是临床修复轮。首轮是 Qwen 时切同家族的下一项；
# 首轮是 DeepSeek 时切 PRIMARY_STRUCTURED_FALLBACK_MODEL（跨家族，端点按模型解析）。
STRUCTURED_INITIAL_CONNECT_TIMEOUT_MS=25000
PRIMARY_PRESCRIBE_CONNECT_FALLBACK_MODEL=qwen3.8-max
# M04 合同/经典方组成修复固定为 formal Max；可用此项单独指定。
PRIMARY_PRESCRIBE_REPAIR_MODEL=qwen3.8-max
# M04 首轮从零完成选药/定量/君臣佐使/病机绑定，严格难于「已指明缺陷」的修复轮，因此不得低于
# 下面的修复档位；设成 low 会让每个病例都多走一轮「低努力度生成→契约驳回→中努力度修复」。
PRIMARY_PRESCRIBE_REASONING_EFFORT=medium
# M04 修复需同时重建剂量、组成与病机引用，默认 medium；可按供应商能力显式调整。
PRIMARY_PRESCRIBE_REPAIR_REASONING_EFFORT=medium
PRIMARY_PRESCRIBE_THINKING_ENABLED=false
# M03/M04 模型复核环节已于 2026-09-16 移除：原先那一组复核模型/超时/回退变量全部删除，
# 设了也不会被读取；签名载荷里的 clinicalReview 固定为 unavailable/not_configured。
# M02 出题语义复核（PRIMARY_REVIEW_MODEL / M02_QUESTION_REVIEW_TIMEOUT_MS）已于 2026-09-25 移除：
# 与出题同模型自评、实测无收益；确定性收口常开，这两个变量不再被读取。
CLINICAL_FACTS_MODEL=qwen3.8-max
# Extraction (and its structure/quote repair retries) on qwen3.8-max, chosen from full golden-baseline
# runs (222 cases, 2026-09-19): flash extraction missed advisory-low-temp-35-5 and
# negated-dizziness-then-severe-headache in 2 of 3 fresh-server samples each. The review/adjudication
# phases were removed on 2026-09-25 (off by default since 09-20: 0 safety-gate differences on 198
# golden cases); CLINICAL_FACTS_REVIEW_MODEL, CLINICAL_FACTS_ADJUDICATION_MODEL and
# CDSS_CLINICAL_FACTS_REVIEW are no longer read. The layer can only add risk, never downgrade it.
# DeepSeek rollback: set AI_TEXT_PROVIDER=openai-compatible and set PRIMARY_DIAGNOSE_MODEL,
# PRIMARY_DIAGNOSE_REPAIR_MODEL, PRIMARY_PRESCRIBE_MODEL, PRIMARY_PRESCRIBE_CONNECT_FALLBACK_MODEL,
# PRIMARY_PRESCRIBE_REPAIR_MODEL, CLINICAL_FACTS_MODEL, and CONTROLLED_TERMINOLOGY_MODEL to
# deepseek-v4-flash.
# The Bailian key may remain configured; provider selection keeps credentials isolated.
# End-to-end semantic screening budget (default 25000ms, clamped to 5000-30000ms) and per-phase
# deadline (default 15000ms, clamped to 3000-20000ms; an out-of-range value falls back to the
# default, not to a shorter one). A timed-out phase is never signed or cached.
CLINICAL_FACTS_TOTAL_TIMEOUT_MS=
CLINICAL_FACTS_PHASE_TIMEOUT_MS=
# HMAC key for clinical-facts attestation signing (falls back to REASONING_CONTRACT_SIGNING_KEY).
CLINICAL_FACTS_ATTESTATION_KEY=
# Semantic backstop kill switch (default enabled). Set to "false" only for deterministic test runs —
# disabling in production removes the semantic red-flag backstop entirely.
CDSS_CLINICAL_FACTS_BACKSTOP=true
# M02 只保留预期信息增益达到阈值的问题；范围 0.3–0.9，默认 0.6。全部低于阈值时直接继续 M03。
M02_MIN_INFORMATION_GAIN=0.6
# ── Ops rollback / feature switches previously undocumented here (2026-08-13 backfill) ──────────
# 安全门处置只有一种：检测照常、结果带置顶安全警示横幅照常生成，不拦截流程。
# （CDSS_GATE_DISPOSITION 及其 block 回退档已于 2026-09-25 删除，设置该变量不再有任何效果。）

# 红旗病例的**剂量授权**：管 M04 能不能印出具体克数（流程与呈现不受影响）。
#   withhold（默认，与线上一致）：红旗未解除时只给非剂量内容。
#   allow（运维回退档）：切回「红旗也照常出剂量方、由医生按警示裁量」的旧行为。
#   任一档下，儿科体重缺失/妊娠阳性/语义筛查不可用/高危剂量这些独立硬边界都照常拦截。
CDSS_REDFLAG_DOSE_AUTHORIZATION=withhold

# M03 parallel two-half generation + server-side merge (91s→28s median). "false" = single-pass rollback.
M03_PARALLEL_GENERATION=true
# M05 model-authored followup content, validated against the governed prohibition table.
# "false" = verbatim deterministic template for every case.
M05_FOLLOWUP_AUTHORING=true
# Authoring deadline (default 20000ms, clamped to 5000-30000ms). On timeout the doctor has waited
# the full budget and still gets the deterministic template, so keep it above the observed p99.
M05_FOLLOWUP_AUTHORING_TIMEOUT_MS=
# Modern-case n-gram recall (derived index, no case text). Default OFF: enabling lifted classic-formula
# recall 35%→53% but broke cold/heat direction symmetry (风寒表证 recalled 银翘散). Keep off until the
# 证候轴 data repair lands — see MODERN_CASE_RECALL_ENABLED in src/lib/tcm-formula-indications.ts.
CDSS_MODERN_CASE_RECALL=false
# health?diagnostics=1 internal detail exposure (default off; never enable on an internet-facing host).
CDSS_HEALTH_DIAGNOSTICS=false
# strict=1 会真实调用六路上游；按认证会话/租户限制每10分钟调用数。需高于 Docker 健康检查频率。
CDSS_STRICT_HEALTH_RATE_LIMIT_PER_10_MIN=60
# Runtime data file locations (defaults under <cwd>/artifacts/runtime/).
CDSS_DRUG_INVENTORY_PATH=
CONTROLLED_TERMINOLOGY_CACHE_PATH=
# Per-stage max-output-token overrides. Defaults: diagnose = PRIMARY_TEXT_MAX_TOKENS,
# prescribe = max(PRIMARY_TEXT_MAX_TOKENS, 18000).
PRIMARY_DIAGNOSE_MAX_TOKENS=
PRIMARY_PRESCRIBE_MAX_TOKENS=
# Release identifier surfaced by /api/diagnosis/health (releaseId).
CDSS_RELEASE_ID=
# Primary generation, validation and bounded repair share this hard end-to-end stage budget.
STRUCTURED_RETRY_TOTAL_TIMEOUT_MS=90000
STRUCTURED_RUN_TOTAL_TIMEOUT_MS=180000
# Absolute wall-clock bounds for the complete structured stages, measured from route entry and
# excluding only the bounded capacity-queue wait. On expiry the stage emits its existing signed
# limited/non-dose fallback and terminates the NDJSON stream. Clamp: 60000-180000.
M03_ORCHESTRATION_DEADLINE_MS=180000
# M04 uses the same 180s release boundary by product decision; identical repair guidance still
# terminates earlier with final_contract_rejected_repair_loop rather than consuming the full cap.
M04_ORCHESTRATION_DEADLINE_MS=180000
# Maximum number of M03/M04 orchestration stages that may fan out against the primary model at
# once in one app process. Admission is round-robin across hashed customers. Queue time has its own
# ceiling and is excluded from the clinical orchestration budget.
PRIMARY_STRUCTURED_STAGE_MAX_CONCURRENCY=8
PRIMARY_STRUCTURED_STAGE_QUEUE_TIMEOUT_MS=25000
PRIMARY_TEXT_MAX_PROMPT_CHARS=60000
PRIMARY_TEXT_MAX_OUTPUT_CHARS=80000

# Tongue-image extraction for M01 is enabled by default. A release must configure the selected provider and
# pass the real multimodal strict-health probe; set false only for an explicitly declared degraded
# deployment, in which doctors manually enter tongue findings and image uploads are rejected.
# glm preserves the GLM configuration below. primary reuses the approved HTTPS primary text endpoint,
# key and deepseek-flash model for native vision; unsupported models fail closed without GLM fallback.
TONGUE_VISION_PROVIDER=glm
# This legacy flag enables/disables tongue images for either selected provider.
GLM_VISION_ENABLED=true
GLM_VISION_MODEL=glm-5v-turbo
GLM_API_KEY=
GLM_VISION_TOTAL_TIMEOUT_MS=120000
GLM_VISION_THINKING_ENABLED=false

# L1b closed-set semantic reranking over deterministic L1a syndrome hypotheses. It can only boost
# an existing L1a candidate by at most 20%; timeout/invalid output falls back to the original L1a order.
SYNDROME_HYPOTHESIS_RERANK=true
# Rerank deadline (default 10000ms, clamped to 3000-20000ms). It blocks the M03 prompt build.
SYNDROME_RERANK_TIMEOUT_MS=

# EviMed guide/consensus evidence retrieval injected into M03/M04 prompts.
# The supplied file documents the guide endpoint; the instruction and literature paths below were
# additionally verified against the live service and remain explicit so contract drift is visible.
EVIMED_API_KEY=
EVIMED_EVIDENCE_API_KEY=
EVIMED_EVIDENCE_BASE_URL=https://www.evimed.com/api-evimed
EVIMED_GUIDE_API_KEY=
EVIMED_INSTRUCTION_API_KEY=
EVIMED_LITERATURE_API_KEY=
EVIMED_EVIDENCE_TIMEOUT_MS=12000
# Transient-failure retries per evidence request (HTTP/business 429 or 5xx, timeout, network
# error only; 250ms*2^attempt backoff). Integer 0-5, default 3.
EVIMED_EVIDENCE_RETRY_ATTEMPTS=3
# Optional qwen3-rerank ordering within the selected guide/literature pool, before final top five.
# Reuses configured Bailian Qwen credentials only at https://dashscope.aliyuncs.com; no custom
# rerank endpoint or redirects. One request, 3000ms total including body, no retries or disk cache.
# At most 32 documents; sanitized query <=2048 UTF-8 bytes, each title+summary <=4096 bytes.
# Budget reduction keeps complete sentences only; no safe sentence means original-order fallback.
# Disabled/unconfigured/failure preserves original order and IDs. Not a strictReady dependency.
EVIDENCE_RERANK_ENABLED=false
# Optional guide endpoint override; instruction/literature use explicit runtime-verified paths.
EVIMED_GUIDE_API_URL=
EVIMED_INSTRUCTION_API_URL=https://www.evimed.com/api-evimed/medicine-api/ai-api/review/api/instruction
EVIMED_LITERATURE_API_URL=https://www.evimed.com/api-evimed/medicine-api/ai-api/search/api/evidence
CDSS_API_TOKEN=replace-with-a-long-random-access-token
CDSS_REQUIRE_API_AUTH=true
# Non-secret identity of the HIS/API integration using the fixed delivery token. It is included in
# trusted customer context and rate-limit scope; it is not a replacement credential.
CDSS_API_CLIENT_ID=his-integrator
# Explicit, case-sensitive bootstrap customer allowlist for the fixed delivery token. JIT-registered
# customers are persisted separately; invalid/duplicate entries or more than 1000 customers fail readiness.
CDSS_API_CUSTOMER_IDS=hospital-A,hospital-B
# First authenticated inventory POST (or POST /api/customers/register) may register an unknown
# customer when it carries a unique Idempotency-Key. Registry/audit files must be on persistent,
# access-controlled storage. Quota includes bootstrap plus JIT customers for this client.
CDSS_CUSTOMER_JIT_ENABLED=true
CDSS_CUSTOMER_JIT_MAX_CUSTOMERS=100
CDSS_CUSTOMER_REGISTRY_PATH=/app/runtime-data/customer-registry.json
CDSS_TENANT_AUDIT_PATH=/app/runtime-data/tenant-audit.ndjson
# 结构化租户审计按大小轮转，默认每文件 8MB、保留 4 个归档文件；自由文本库存来源不写审计。
CDSS_TENANT_AUDIT_MAX_BYTES=8000000
CDSS_TENANT_AUDIT_ARCHIVE_FILES=4
# Temporary compatibility for callers not yet sending x-cdss-customer-id and without a signed
# customer cookie. Must be one valid 6-64 character identifier already present in
# CDSS_API_CUSTOMER_IDS. Remove after every caller is tenant-aware.
CDSS_DEFAULT_CUSTOMER_ID=
# Login rate-limit IP keying. Production topology assumes the app sits BEHIND a reverse proxy
# (nginx/Caddy/ALB) that terminates TLS and sets a trustworthy x-forwarded-for. Set to true ONLY in
# that topology; if the app is exposed directly, leave it false. The limiter is in-memory and
# per-process (single-instance assumption) — use a shared store if you run multiple replicas.
CDSS_TRUST_PROXY_HEADERS=true
# Only used when CDSS_TRUST_PROXY_HEADERS=true. Prefer proxy-written X-Real-IP for login/API
# rate-limit identity. X-Forwarded-For is not used as the limiter key by default because clients can
# spoof it unless your edge proxy strips and rewrites it; enable the compatibility flag only in that
# topology. Enable CF only when a trusted edge/proxy strips client-supplied CF-Connecting-IP and
# rewrites it from Cloudflare.
CDSS_TRUST_X_FORWARDED_FOR=true
CDSS_ALLOW_X_FORWARDED_FOR_CLIENT_KEY=false
CDSS_TRUST_CF_CONNECTING_IP=false
# Per authenticated browser session or API-token tenant and customer. One complete M01-M05 run uses several
# invocations. Raise this for a dedicated regression tenant; use a shared limiter at the reverse
# proxy/Redis layer before running multiple Next.js replicas.
CDSS_MODEL_RATE_LIMIT_PER_10_MIN=60
# Production should keep Secure cookies on behind the TLS reverse proxy. Set false only for local HTTP tests.
CDSS_SECURE_COOKIE=true

# Browser-side case/workspace persistence. Builds default to enabled unless this is explicitly false.
# The server encrypts each snapshot with AES-256-GCM and binds it to a random browser workspace;
# localStorage contains only the encrypted envelope for up to 24h. A dedicated secret is mandatory.
NEXT_PUBLIC_ENABLE_BROWSER_CASE_PERSISTENCE=true
CASE_SNAPSHOT_ENCRYPTION_KEY=
REASONING_CONTRACT_SIGNING_KEY=

# Clinic TCM treatment capabilities. JSON is preferred; the simple comma-separated list is a
# compatibility option and never enables specialist procedures for onsite delivery.
TCM_CLINIC_TREATMENT_CAPABILITIES_JSON='{"schemaVersion":"tcm-cdss-clinic-treatment-capabilities-v1","items":[{"projectCode":"acupuncture","deliveryMode":"onsite","priority":10},{"projectCode":"moxibustion","deliveryMode":"onsite","priority":20},{"projectCode":"tuina","deliveryMode":"onsite","priority":30},{"projectCode":"cupping","deliveryMode":"onsite","priority":40},{"projectCode":"guasha","deliveryMode":"onsite","priority":50},{"projectCode":"auricular","deliveryMode":"onsite","priority":60},{"projectCode":"diet_therapy","deliveryMode":"onsite","priority":70},{"projectCode":"qigong_daoyin","deliveryMode":"onsite","priority":80}]}'
TCM_CLINIC_TREATMENT_CAPABILITIES=

# 合理用药审方（灵犀）已按 owner 裁定（2026-09-25）永久停用并从代码中删除：CDSS 不再调用任何
# 外部审方/药品查询接口，RXAI_AUDIT_* / RXAI_QUERY_ENABLED / CDSS_SHOW_RX_AUDIT_SECTION 均已无读者，
# 旧部署里残留这些变量也不会改变任何行为。本地确定性检测（十八反十九畏、药典剂量边界、特殊人群、
# 缺剂量/现用药待核对）与 M05 确定性安全总评照常工作。
IMAGE_TAG=replace-with-immutable-release-tag
NEXT_PUBLIC_BASE_PATH=/tcm-cdss
