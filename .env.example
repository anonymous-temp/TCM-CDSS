# TCM CDSS text model: all generation, repair and review phases use DeepSeek V4 Flash (0731 正式版, served under the stable id deepseek-v4-flash).
AI_TEXT_PROVIDER=openai-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
CDSS_DEEPSEEK_ALLOWED_HOSTS=
OPENAI_MODEL=deepseek-v4-flash
# 独立闭集术语归一层（不是临床生成阶段的降级模型）：精确匹配 miss 后由 Flash
# 在服务端预筛候选中双次一致选择；只形成待医生确认的召回建议，不静默替换签名主证候。
CONTROLLED_TERMINOLOGY_NORMALIZATION=true
CONTROLLED_TERMINOLOGY_MODEL=deepseek-v4-flash
CONTROLLED_TERMINOLOGY_MIN_CONFIDENCE=0.8
# 两条并集/删减型辅助语义层。默认开启；失败均降级到确定性结果，不得改写患者事实或放宽门禁。
FORMULA_RECALL_NORMALIZATION=true
POLARITY_NEGATION_ASSIST=true
# 可选。未配置时写入 artifacts/runtime；生产容器可挂载持久卷并指向该目录。
# CONTROLLED_TERMINOLOGY_CACHE_PATH=/var/lib/tcm-cdss/controlled-terminology-cache.json
PRIMARY_TEXT_TEMPERATURE=0.1
PRIMARY_TEXT_MAX_TOKENS=14000
PRIMARY_TEXT_REASONING_EFFORT=low
PRIMARY_DIAGNOSE_REASONING_EFFORT=medium
# M03 结构化定向修复会在通过后再经独立临床复核，默认 low 避免重复一整轮诊断推理时延。
PRIMARY_DIAGNOSE_REPAIR_REASONING_EFFORT=low
# 缺省与本行一致为 false。项目会把“仅返回 reasoning_content、没有最终 content”视为错误，
# 因此部署若主动开启思考模式，必须用 model-health?check=1 验证供应商仍返回最终正文。
# M02 没有独立的 *_THINKING_ENABLED 覆盖项，会跟随本开关。
PRIMARY_TEXT_THINKING_ENABLED=false
# M03 keeps a higher reasoning budget; model identity remains V4 Flash for every text phase.
PRIMARY_DIAGNOSE_MODEL=deepseek-v4-flash
# M03 语义修复会从患者事实重新生成完整诊断，结果仍须经全新的复核请求独立校验。
PRIMARY_DIAGNOSE_REPAIR_MODEL=deepseek-v4-flash
PRIMARY_DIAGNOSE_THINKING_ENABLED=false
PRIMARY_PRESCRIBE_MODEL=deepseek-v4-flash
# M04 合同/经典方组成修复默认升配到 PRIMARY_DIAGNOSE_MODEL；可用此项单独指定。
PRIMARY_PRESCRIBE_REPAIR_MODEL=deepseek-v4-flash
# M04 首轮从零完成选药/定量/君臣佐使/病机绑定，严格难于「已指明缺陷」的修复轮，因此不得低于
# 下面的修复档位；设成 low 会让每个病例都多走一轮「低努力度生成→契约驳回→中努力度修复」。
PRIMARY_PRESCRIBE_REASONING_EFFORT=medium
# M04 修复需同时重建剂量、组成与病机引用，默认 medium；可按供应商能力显式调整。
PRIMARY_PRESCRIBE_REPAIR_REASONING_EFFORT=medium
PRIMARY_PRESCRIBE_THINKING_ENABLED=false
# M03/M04 clinical review is a separate request with a review-only prompt and no generator
# conversation state. It stays on DeepSeek V4 Flash unless the Bailian topology is explicitly enabled.
PRIMARY_CLINICAL_REVIEW_PROVIDER=primary
PRIMARY_CLINICAL_REVIEW_MODEL=deepseek-v4-flash
# To enable the implemented cross-provider reviewer, set PRIMARY_CLINICAL_REVIEW_PROVIDER=bailian-qwen
# and configure the provider-specific settings below. PRIMARY_CLINICAL_REVIEW_MODEL remains the
# primary-provider model and is intentionally ignored by the Bailian branch.
BAILIAN_QWEN_API_KEY=
BAILIAN_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_QWEN_MODEL=qwen-plus
# Legacy alternate-reviewer key/URL placeholders below are not used by the current topology.
PRIMARY_CLINICAL_REVIEW_API_KEY=
PRIMARY_CLINICAL_REVIEW_API_URL=
PRIMARY_CLINICAL_REVIEW_REASONING_EFFORT=low
PRIMARY_CLINICAL_REVIEW_TIMEOUT_MS=30000
PRIMARY_CLINICAL_REVIEW_CHAIN_TIMEOUT_MS=35000
PRIMARY_CLINICAL_REVIEW_ALLOWED_HOSTS=
PRIMARY_DIAGNOSE_REVIEW_FALLBACK_MODEL=deepseek-v4-flash
PRIMARY_PRESCRIBE_REVIEW_FALLBACK_MODEL=deepseek-v4-flash
CLINICAL_FACTS_MODEL=deepseek-v4-flash
# Currently unused — the clinical-facts repair path falls back through CLINICAL_FACTS_MODEL.
CLINICAL_FACTS_REPAIR_MODEL=deepseek-v4-flash
# Clinical-facts review/adjudication use separate requests. Because all phases are pinned to the
# same approved model, same-model downstream calls may add risk but may not erase/downgrade it.
CLINICAL_FACTS_REVIEW_MODEL=deepseek-v4-flash
CLINICAL_FACTS_ADJUDICATION_MODEL=deepseek-v4-flash
# End-to-end semantic screening budget (default 25000ms, clamped to 5000-30000ms) and per-phase
# deadline (default 8000ms, clamped to 3000-12000ms). The independent review gets one bounded retry.
CLINICAL_FACTS_TOTAL_TIMEOUT_MS=
CLINICAL_FACTS_PHASE_TIMEOUT_MS=
# HMAC key for clinical-facts attestation signing (falls back to REASONING_CONTRACT_SIGNING_KEY).
CLINICAL_FACTS_ATTESTATION_KEY=
# Safety kill switches (default true/enabled). Set to "false" only for deterministic test runs —
# disabling in production removes the semantic backstop / dual-model review.
CDSS_CLINICAL_FACTS_BACKSTOP=true
CDSS_CLINICAL_FACTS_REVIEW=true
# Release identifier surfaced by /api/diagnosis/health (releaseId).
CDSS_RELEASE_ID=
# Primary generation, validation and bounded repair share this hard end-to-end stage budget.
STRUCTURED_RETRY_TOTAL_TIMEOUT_MS=90000
STRUCTURED_RUN_TOTAL_TIMEOUT_MS=180000
# Wall-clock bound for EXTRA M03 (diagnose) generation rounds only. The first pass is bounded by
# the stream timeouts; this deadline is checked before launching each additional semantic-repair
# round. On expiry the stage routes promptly to the existing pre-signed limited fallback
# (telemetry reason signed_limited_fallback_deadline) instead of burning another full model round.
# Default 120000 = STRUCTURED_RUN_TOTAL_TIMEOUT_MS (180s) minus one worst-case idle-bound round
# tail (60s); with one in-flight repair (≤ STRUCTURED_RETRY_TOTAL_TIMEOUT_MS) plus a few seconds
# of review, worst-case M03 stays ≈ ≤220s, well under the 300s client abort. Clamp: 60000-180000.
M03_ORCHESTRATION_DEADLINE_MS=180000
# Same bounding for M04 (prescribe): checked before launching each additional repair round. On
# expiry the stage routes promptly to the existing non-dose truncated contract (telemetry reason
# final_contract_rejected_deadline); a repeated identical repair hint stops early with reason
# final_contract_rejected_repair_loop. Same derivation and clamp as M03_ORCHESTRATION_DEADLINE_MS.
M04_ORCHESTRATION_DEADLINE_MS=120000
PRIMARY_TEXT_MAX_PROMPT_CHARS=60000
PRIMARY_TEXT_MAX_OUTPUT_CHARS=80000

# Tongue-image extraction for M01 is enabled by default. A release must provide a valid GLM key and
# pass the real multimodal strict-health probe; set false only for an explicitly declared degraded
# deployment, in which doctors manually enter tongue findings and image uploads are rejected.
GLM_VISION_ENABLED=true
GLM_VISION_MODEL=glm-5v-turbo
GLM_API_KEY=
GLM_VISION_TOTAL_TIMEOUT_MS=120000
GLM_VISION_THINKING_ENABLED=false

# L1b closed-set semantic reranking over deterministic L1a syndrome hypotheses. It can only boost
# an existing L1a candidate by at most 20%; timeout/invalid output falls back to the original L1a order.
SYNDROME_HYPOTHESIS_RERANK=true

# EviMed guide/consensus evidence retrieval injected into M03/M04 prompts.
# The supplied file documents the guide endpoint; the instruction and literature paths below were
# additionally verified against the live service and remain explicit so contract drift is visible.
EVIMED_API_KEY=
EVIMED_EVIDENCE_API_KEY=
EVIMED_EVIDENCE_BASE_URL=https://www.evimed.com/api-evimed
EVIMED_GUIDE_API_KEY=
EVIMED_INSTRUCTION_API_KEY=
EVIMED_LITERATURE_API_KEY=
EVIMED_EVIDENCE_TIMEOUT_MS=12000
# Transient-failure retries per evidence request (HTTP/business 429 or 5xx, timeout, network
# error only; 250ms*2^attempt backoff). Integer 0-5, default 3.
EVIMED_EVIDENCE_RETRY_ATTEMPTS=3
# Optional guide endpoint override; instruction/literature use explicit runtime-verified paths.
EVIMED_GUIDE_API_URL=
EVIMED_INSTRUCTION_API_URL=https://www.evimed.com/api-evimed/medicine-api/ai-api/review/api/instruction
EVIMED_LITERATURE_API_URL=https://www.evimed.com/api-evimed/medicine-api/ai-api/search/api/evidence
CDSS_API_TOKEN=replace-with-a-long-random-access-token
CDSS_REQUIRE_API_AUTH=true
# Login rate-limit IP keying. Production topology assumes the app sits BEHIND a reverse proxy
# (nginx/Caddy/ALB) that terminates TLS and sets a trustworthy x-forwarded-for. Set to true ONLY in
# that topology; if the app is exposed directly, leave it false. The limiter is in-memory and
# per-process (single-instance assumption) — use a shared store if you run multiple replicas.
CDSS_TRUST_PROXY_HEADERS=true
# Only used when CDSS_TRUST_PROXY_HEADERS=true. Prefer proxy-written X-Real-IP for login/API
# rate-limit identity. X-Forwarded-For is not used as the limiter key by default because clients can
# spoof it unless your edge proxy strips and rewrites it; enable the compatibility flag only in that
# topology. Enable CF only when a trusted edge/proxy strips client-supplied CF-Connecting-IP and
# rewrites it from Cloudflare.
CDSS_TRUST_X_FORWARDED_FOR=true
CDSS_ALLOW_X_FORWARDED_FOR_CLIENT_KEY=false
CDSS_TRUST_CF_CONNECTING_IP=false
# Per authenticated browser session or API-token tenant. One complete M01-M05 run uses several
# invocations. Raise this for a dedicated regression tenant; use a shared limiter at the reverse
# proxy/Redis layer before running multiple Next.js replicas.
CDSS_MODEL_RATE_LIMIT_PER_10_MIN=60
# Production should keep Secure cookies on behind the TLS reverse proxy. Set false only for local HTTP tests.
CDSS_SECURE_COOKIE=true

# Browser-side case/workspace persistence. Builds default to enabled unless this is explicitly false.
# The server encrypts each snapshot with AES-256-GCM and binds it to a random browser workspace;
# localStorage contains only the encrypted envelope for up to 24h. A dedicated secret is mandatory.
NEXT_PUBLIC_ENABLE_BROWSER_CASE_PERSISTENCE=true
CASE_SNAPSHOT_ENCRYPTION_KEY=
REASONING_CONTRACT_SIGNING_KEY=

# Clinic TCM treatment capabilities. JSON is preferred; the simple comma-separated list is a
# compatibility option and never enables specialist procedures for onsite delivery.
TCM_CLINIC_TREATMENT_CAPABILITIES_JSON='{"schemaVersion":"tcm-cdss-clinic-treatment-capabilities-v1","items":[{"projectCode":"acupuncture","deliveryMode":"onsite","priority":10},{"projectCode":"moxibustion","deliveryMode":"onsite","priority":20},{"projectCode":"tuina","deliveryMode":"onsite","priority":30},{"projectCode":"cupping","deliveryMode":"onsite","priority":40},{"projectCode":"guasha","deliveryMode":"onsite","priority":50},{"projectCode":"auricular","deliveryMode":"onsite","priority":60},{"projectCode":"diet_therapy","deliveryMode":"onsite","priority":70},{"projectCode":"qigong_daoyin","deliveryMode":"onsite","priority":80}]}'
TCM_CLINIC_TREATMENT_CAPABILITIES=

# Rational-drug-use audit. Results are advisory: actual issue IDs are shown when available; an
# unavailable audit is surfaced for manual review but does not become a workflow hard stop.
RXAI_AUDIT_ENABLED=false
RXAI_AUDIT_BASE_URL=
RXAI_AUDIT_ALLOW_INSECURE_HTTP=false
# Comma-separated explicit host allowlist for plain-HTTP audit traffic ("host" or "host:port").
# Only for vendors that cannot serve HTTPS: the token and the sanitized clinical summary cross
# the network unencrypted to these hosts. Empty = only same-host sidecar URLs are allowed.
RXAI_AUDIT_ALLOW_INSECURE_HTTP_HOSTS=
RXAI_AUDIT_TENANT_ID=EH_INTERNET_HOSPITAL
RXAI_AUDIT_SYSTEM_CODE=EH_INTERNET_HOSPITAL
# Current LingXi authentication header: X-API-Key. RXAI_AUDIT_TOKEN remains a legacy alias.
RXAI_AUDIT_API_KEY=
RXAI_AUDIT_TOKEN=
# One shared 30s budget covers medication semantics plus provider response. Keeping the attempt
# budget equal prevents a valid 12–15s cold response from being aborted and duplicated.
RXAI_AUDIT_TOTAL_TIMEOUT_MS=30000
RXAI_AUDIT_ATTEMPT_TIMEOUT_MS=30000
# Backward-compatible legacy total timeout (prefer RXAI_AUDIT_TOTAL_TIMEOUT_MS).
RXAI_AUDIT_TIMEOUT_MS=
RXAI_AUDIT_RETRY_ATTEMPTS=1
IMAGE_TAG=replace-with-immutable-release-tag
NEXT_PUBLIC_BASE_PATH=/tcm-cdss
